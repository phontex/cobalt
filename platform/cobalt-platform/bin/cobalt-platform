#!/system/bin/sh
# Cobalt Platform 0.1: deterministic status/discovery backend. It never downloads or patches APKs.
set -u
ROOT=/data/adb/cobalt-platform
LOGDIR="$ROOT/logs"
STATUS="$ROOT/status.json"
CONFIG="$ROOT/config.conf"
mkdir -p "$ROOT" "$LOGDIR" "$ROOT/inbox" "$ROOT/cache" "$ROOT/backup" 2>/dev/null || true
log(){
  level="$1"; event="$2"; target="${3:-}"; message="${4:-}"
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)
  printf '%s\t%s\t%s\t%s\t%s\n' "$ts" "$level" "$event" "$target" "$message" >> "$LOGDIR/platform.log"
  tail -n 5000 "$LOGDIR/platform.log" > "$LOGDIR/platform.log.tmp" 2>/dev/null && mv "$LOGDIR/platform.log.tmp" "$LOGDIR/platform.log" 2>/dev/null || true
}
json_escape(){ printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
find_apk(){ pm path "$1" 2>/dev/null | sed -n 's/^package://p' | head -n 1; }
version_line(){ dumpsys package "$1" 2>/dev/null | grep -m1 'versionName=' | tr -d '\r'; }
write_status(){
  root_ok=0; idout=$(id 2>/dev/null || true); echo "$idout" | grep -q 'uid=0' && root_ok=1
  printf '{"module_id":"cobalt-platform","module_version":"0.1.0","api_version":1,"root":%s,"enabled":true,"apk_patching":false,"network":false,"updated_at":"%s"}\n' "$root_ok" "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)" > "$STATUS"
}
status(){
  write_status
  cat "$STATUS"
  log info status '' 'status requested'
}
discover(){
  target="${1:-}"; [ -n "$target" ] || { echo 'usage: cobalt-platform discover PACKAGE'; return 2; }
  apk=$(find_apk "$target")
  if [ -z "$apk" ]; then log warn discover "$target" 'package not installed'; echo '{"installed":false}'; return 1; fi
  ver=$(version_line "$target")
  splits=$(pm path "$target" 2>/dev/null | sed 's/^package://' | tr '\n' ';')
  printf '{"installed":true,"package":"%s","base_apk":"%s","version":"%s","splits":"%s"}\n' "$(json_escape "$target")" "$(json_escape "$apk")" "$(json_escape "$ver")" "$(json_escape "$splits")"
  log info discover "$target" "found $apk"
}
apply_profile(){
  target="${1:-}"; [ -n "$target" ] || { echo 'usage: cobalt-platform apply PACKAGE'; return 2; }
  # Version-aware application is intentionally not enabled until a reviewed adapter exists.
  if [ -z "$(find_apk "$target")" ]; then log warn apply "$target" 'package not installed'; return 1; fi
  log warn apply "$target" 'no reviewed adapter applied; runtime/LSPosed handles text translation'
  echo 'no adapter applied'
  return 3
}
rollback(){ target="${1:-}"; log info rollback "$target" 'no APK mount to remove in this release'; echo 'nothing to rollback'; }
logs(){ cat "$LOGDIR/platform.log" 2>/dev/null || true; }
clear_logs(){ : > "$LOGDIR/platform.log"; log info clear_logs '' 'logs cleared'; }
case "${1:-status}" in
 boot) write_status; log info boot '' 'Cobalt Platform started without APK or network';;
 status) status;;
 discover) discover "${2:-}";;
 apply) apply_profile "${2:-}";;
 rollback) rollback "${2:-}";;
 logs) logs;;
 clear-logs) clear_logs;;
 *) echo 'usage: cobalt-platform {status|discover PACKAGE|apply PACKAGE|rollback PACKAGE|logs|clear-logs}'; exit 2;;
esac
